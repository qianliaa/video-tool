#!/bin/bash
# install_callback 在 app.tgz 解压之后执行，此时 ${TRIM_APPDEST}/server 才存在
# 本应用后端只用 Python 标准库，不需要 pip / venv / 联网安装依赖

LOG="${TRIM_PKGVAR}/install.log"
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || LOG="/tmp/video-tool-install.log"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG}" 2>&1; }

log "=== install_callback start ==="
log "TRIM_APPDEST=${TRIM_APPDEST}"
log "TRIM_PKGVAR=${TRIM_PKGVAR}"

SERVER_DIR="${TRIM_APPDEST}/server"

if [ ! -d "${SERVER_DIR}" ]; then
    log "ERROR: server dir not found: ${SERVER_DIR}"
    ls -la "${TRIM_APPDEST}" >> "${LOG}" 2>&1
    exit 0
fi
log "SERVER_DIR=${SERVER_DIR} OK"

# 优先使用飞牛 Python 运行时（manifest 里通过 install_dep_apps 声明）
PY=""
for c in /var/apps/python311/target/bin/python3 \
         /var/apps/python312/target/bin/python3 \
         /var/apps/python310/target/bin/python3 \
         /var/apps/python39/target/bin/python3; do
    if [ -x "$c" ]; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
    for c in python3 python; do
        if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
    done
fi
if [ -z "$PY" ]; then
    log "ERROR: python3/python not found"
else
    log "python: ${PY} $($PY --version 2>&1)"
    if "$PY" -m py_compile "${SERVER_DIR}/app.py" >> "${LOG}" 2>&1; then
        log "app.py syntax OK"
    else
        log "ERROR: app.py syntax check failed"
    fi
fi

if command -v ffmpeg >/dev/null 2>&1; then
    log "ffmpeg: $(command -v ffmpeg) $(ffmpeg -version 2>/dev/null | head -n 1)"
else
    log "WARN: ffmpeg not found in PATH"
fi

log "downloader: ffmpeg native (no yt-dlp)"

# 为已在「系统设置 › 应用 › 视频助手 › 访问权限」中授权的目录补齐读写 ACL。
# 未授权时脚本会记录 0 个目录；用户后续授权时由 config_callback 自动补跑。
CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
ACL_SCRIPT="${CMD_DIR}/acl_apply"
[ -f "${ACL_SCRIPT}" ] || ACL_SCRIPT="${TRIM_APPDEST}/../cmd/acl_apply"
if [ -f "${ACL_SCRIPT}" ]; then
    log "acl: quick pass"
    bash "${ACL_SCRIPT}" >> "${LOG}" 2>&1
    log "acl: background full pass started"
    if command -v setsid >/dev/null 2>&1; then
        nohup setsid bash "${ACL_SCRIPT}" --full >/dev/null 2>&1 &
    else
        nohup bash "${ACL_SCRIPT}" --full >/dev/null 2>&1 &
    fi
else
    log "WARN: acl_apply 缺失，跳过自动授权"
fi

log "=== install_callback done ==="
exit 0
