#!/bin/bash
LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

SERVER_DIR="${TRIM_APPDEST}/server"
ENTRY="${SERVER_DIR}/app.py"

mkdir -p "${TRIM_PKGVAR}" 2>/dev/null

log_msg() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"; }
check_process() { kill -0 "$1" 2>/dev/null; }

PYBIN=""
for c in /var/apps/python311/target/bin/python3 \
         /var/apps/python312/target/bin/python3 \
         /var/apps/python310/target/bin/python3 \
         /var/apps/python39/target/bin/python3; do
    if [ -x "$c" ]; then PYBIN="$c"; break; fi
done
[ -n "${PYBIN}" ] || PYBIN="$(command -v python3 || command -v python)"

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then return 0; else rm -f "${PID_FILE}"; fi
    fi
    return 1
}

start_process() {
    if status; then log_msg "already running"; return 0; fi
    log_msg "Starting process ..."
    log_msg "TRIM_APPDEST=${TRIM_APPDEST}"
    log_msg "PYBIN=${PYBIN}"
    log_msg "ENTRY=${ENTRY}"

    if [ -z "${PYBIN}" ] || [ ! -f "${ENTRY}" ]; then
        log_msg "ERROR: python or app.py missing"
        return 1
    fi

    cd "${SERVER_DIR}" || { log_msg "ERROR: cd failed"; return 1; }
    PORT=18080 \
        "${PYBIN}" "${ENTRY}" --host 0.0.0.0 --port 18080 >> "${LOG_FILE}" 2>&1 &
    local p=$!
    printf "%s" "$p" > "${PID_FILE}"
    log_msg "pid = ${p}"
    sleep 3
    if check_process "${p}"; then
        log_msg "started OK"
    else
        log_msg "ERROR: process died immediately, see log above"
    fi
    return 0
}

stop_process() {
    log_msg "Stopping process ..."
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"; log_msg "not running"; return 0
        fi
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1; count=$((count + 1))
            log_msg "waiting terminal... (${count}s/10s)"
        done
        if check_process "${pid}"; then
            log_msg "send KILL"; kill -KILL "${pid}"; sleep 1
        else
            log_msg "killed cleanly"
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

case $1 in
start)  start_process ;;
stop)   stop_process ;;
status) if status; then exit 0; else exit 3; fi ;;
*)      exit 1 ;;
esac