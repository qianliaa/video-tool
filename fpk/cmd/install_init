#!/bin/bash
# install_init 在 app.tgz 解压之前执行，此时 target 目录还是空的
# 任何依赖检查与安装都必须放到 install_callback 里做

LOG="${TRIM_PKGVAR}/install.log"
mkdir -p "${TRIM_PKGVAR}" 2>/dev/null || LOG="/tmp/video-tool-install.log"

echo "$(date '+%Y-%m-%d %H:%M:%S') - install_init: skip, app.tgz not extracted yet (TRIM_APPDEST=${TRIM_APPDEST})" >> "${LOG}" 2>&1

exit 0
